# Copy to .env (git-ignored) and fill in.

# Vision + Space-fallback LLM. Get a free key at aistudio.google.com -> "Get API key".
GEMINI_API_KEY=

# Optional overrides (defaults shown):
# GEMINI_MODEL=gemini-2.0-flash
# LLM_BACKEND=auto        # auto|cli|gemini|api
# CLAUDE_MODEL=sonnet     # used for the "smart" tier via the claude CLI
# AUDIO_STT_SIZE=small    # whisper model size override

# Only needed if neither the claude CLI nor GEMINI_API_KEY is available:
# ANTHROPIC_API_KEY=
